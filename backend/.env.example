# Supabase Transaction pooler (port 6543). Use this for API/server workloads.
# Session pooler (5432) holds one server connection per client and exhausts fast.
DATABASE_URL=postgresql://postgres.PROJECT_ID:YOUR_DATABASE_PASSWORD@YOUR_POOLER_HOST:6543/postgres

# Optional pool tuning and SSL override for local development.
# DATABASE_POOL_MIN=1
# DATABASE_POOL_MAX=10
# DATABASE_SSLMODE=require

# Supabase Auth token verification. Use the publishable key, never a service key.
SUPABASE_URL=https://PROJECT_ID.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Application Server Configuration
PORT=5000
