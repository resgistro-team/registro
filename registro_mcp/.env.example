# Where the Registro API lives.
REGISTRO_API_URL=https://registro-api-eight.vercel.app

# Hosted mode (sign-in on). Leave MCP_PUBLIC_URL empty to run locally over stdio without sign-in.
MCP_PUBLIC_URL=https://registro-mcp.vercel.app/mcp
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Local stdio mode only: a signed-in user's access token, for the tools that act as that person.
REGISTRO_ACCESS_TOKEN=
