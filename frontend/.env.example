# Supabase Auth. Both values are safe to expose to the browser.
# Find them in the Supabase dashboard: Project Settings > API.
# Leave them empty and the sign-in screens run in preview mode: nothing is saved.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Ahmed's Flask API. Leave empty to show sample events with registration switched off.
NEXT_PUBLIC_API_URL=
